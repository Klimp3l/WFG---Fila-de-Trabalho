# versao 1.0

# Alterações:
# |    Data    | Programador | Solicitante | Caso Mantis | Descrição 
# | 19/10/2026 | IANDev      |             |             | Catálogo único de colunas do aplicativo.
#
# Tarefa include. Usada por HEAVEN-wfg-fila-trabalho-mobile-backend e HEAVEN-cad-atividade-processo.
# Cadastrar com include = 1.

<script_function name="getColunasAplicativo">
	~write_exec_log;
	set run = ''+execScript.getTarefaExecucao().setObs('GET - getColunasAplicativo');

	connect $v{ds_bridge};

	sql
	select
		json_build_array(
			json_build_object(
				'label', 'Produto',
				'icon', 'fa-solid fa-tags',
				'itens', json_build_array(
					json_build_object('key', 'produto', 'label', 'Produto', 'type', 'input', 'searchable', true, 'sortable', true, 'defaultVisible', true),
					json_build_object('key', 'idproduto', 'label', 'ID Produto', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-genderless', 'defaultVisible', true),
					json_build_object('key', 'codigobarras', 'label', 'Código barras', 'type', 'input', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-barcode', 'defaultVisible', true),
					json_build_object('key', 'classe', 'label', 'Classe', 'type', 'multipleSelect', 'options', ARRAY['A', 'B', 'C'], 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-layer-group'),
					json_build_object('key', 'fornecedor', 'label', 'Fornecedor', 'type', 'input', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-truck-fast')
				)
			),
			json_build_object(
				'label', 'Mercadológicos',
				'icon', 'fa-solid fa-layer-group',
				'itens', json_build_array(
					json_build_object('key', 'departamento', 'label', 'Departamento', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'setor', 'label', 'Setor', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'grupo', 'label', 'Grupo', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'familia', 'label', 'Família', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building')
				)
			),
			json_build_object(
				'label', 'Datas',
				'icon', 'fa-solid fa-calendar-days',
				'itens', json_build_array(
					json_build_object('key', 'datainclusao', 'label', 'Data Inclusão', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-plus', 'defaultVisible', true),
					json_build_object('key', 'diassemvenda', 'label', 'Dias sem venda', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'diasentrada', 'label', 'Dias entrada', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'dataultimavenda', 'label', 'Data última venda', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'dataultimaentrada', 'label', 'Data última entrada', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-day'),
					json_build_object('key', 'datavalidade', 'label', 'Data validade', 'type', 'input', 'inputType', 'date', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-calendar-xmark'),
					json_build_object('key', 'datavencimento', 'label', 'Dt. Venc.', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-xmark', 'defaultVisible', true),
					json_build_object('key', 'diasparavencimento', 'label', 'Dias p/ Venc.', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days', 'defaultVisible', true),
					json_build_object('key', 'datavencimentorevisada', 'label', 'Dt. Venc. Revisada', 'type', 'input', 'inputType', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-check', 'defaultVisible', true)
				)
			),
			json_build_object(
				'label', 'Valores',
				'icon', 'fa-solid fa-money-bill-wave',
				'itens', json_build_array(
					json_build_object('key', 'valorprecovenda', 'label', 'Valor preço venda', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-money-bill-wave', 'defaultVisible', true),
					json_build_object('key', 'valorcustoaquisicao', 'label', 'Valor custo aquisição', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-hand-holding-dollar')
				)
			),
			json_build_object(
				'label', 'Quantidade',
				'icon', 'fa-solid fa-scale-balanced',
				'itens', json_build_array(
					json_build_object('key', 'qtdultimaentrada', 'label', 'Quantidade última entrada', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dolly'),
					json_build_object('key', 'qtdeultimavenda', 'label', 'Quantidade última venda', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dollar-sign'),
					json_build_object('key', 'qtdvendamedia', 'label', 'Quantidade venda média', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-cart-shopping'),
					json_build_object('key', 'qtdproducaobandeja', 'label', 'Quantidade produção bandeja', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-kitchen-set'),
					json_build_object('key', 'capacidade', 'label', 'Capacidade', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-cubes'),
					json_build_object('key', 'qtdunentrada', 'label', 'Quantidade unidade entrada', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dolly'),
					json_build_object('key', 'qtdproduzido', 'label', 'Quantidade produzido', 'type', 'input', 'inputType', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-kitchen-set'),
					json_build_object('key', 'qtdrevisada', 'label', 'Qtd. Revisada', 'type', 'input', 'inputType', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-clipboard-check', 'defaultVisible', true),
					json_build_object('key', 'qtdvendidoaposconferencia', 'label', 'Qtd. Vendido Após Conf.', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-cart-shopping', 'defaultVisible', true)
				)
			),
			json_build_object(
				'label', 'Estoque',
				'icon', 'fa-solid fa-boxes-stacked',
				'itens', json_build_array(
					json_build_object('key', 'qtdestoqueatual', 'label', 'Est. Atual', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked', 'defaultVisible', true),
					json_build_object('key', 'saldoestoquedataproxima', 'label', 'Saldo Est. (Dt. Próx.)', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked', 'defaultVisible', true),
					json_build_object('key', 'estoquequantidade', 'label', 'Estoque quantidade', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked'),
					json_build_object('key', 'percentualabastecimento', 'label', 'Percentual abastecimento', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-percent'),
					json_build_object('key', 'qtdeabastecer', 'label', 'Quantidade abastecer', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-box-open'),
					json_build_object('key', 'qtdultinventario', 'label', 'Quantidade último inventário', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-boxes-packing'),
					json_build_object('key', 'qtdestoqueatualcd', 'label', 'Estoque atual CD', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-warehouse'),
					json_build_object('key', 'qtdestoquecorreta', 'label', 'Quantidade estoque correto', 'type', 'input', 'inputType', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked')
				)
			)
		) as grupos,
		json_build_object(
			'30010', json_build_object(
				'datavencimentorevisada', json_build_object('type', 'date', 'inputType', null),
				'qtdrevisada', json_build_object('type', 'inputNumber', 'inputType', null)
			)
		) as excecoes
	sql_var(sqlCatalogo) sql_props(lower_labels);

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> msgBuilder.setContentEncoding('gzip');
	$> msgBuilder.setCharset('UTF-8');
	$> sb.append(msgBuilder.sqlVarToJSON('sqlCatalogo'));
</script_function>
