# Alterações:
# |    Data    | Programador | Solicitante | Caso Mantis | Descrição 
# | 04/05/2022 | Bernardo    | 		       | 	 	     | Criação.
# | 06/08/2026 | Bernardo    | 		       | 	 	     | Incluídas colunas padrão da conferência de vencimento.
# | 06/08/2026 | Bernardo    | 		       | 	 	     | Busca o tipo de situação da atividade no envio.

<script_function name="getAtividades">
	~write_exec_log;
	set run = ''+execScript.getTarefaExecucao().setObs('getAtividades -  $v{usuario}');

	set idUsuario = "$v{idUsuario}".equals("700007") ? 6 : $v{idUsuario};

	#######################
	# Busca os Parâmetros #
	#######################

	connect $v{ds_bridge};

	sql 
	with 
	wbase as (
		select
			e.idempresa as idempresa,
			coalesce(e.apelido, e.nomefantasia) as empresa,
			p.idwfprocesso as idwfprocesso,
			trim(p.descricao) as wfprocesso,
			a.idwfatividade as idwfatividade,
			trim(a.descricao) as wfatividade,
			ft.idwffilatrabalho,
			ft.idwffilatrabalhoanterior,
			ft.idwfocorrencia,
			ft.idwfatividaderealizada,
			ft.datainclusao,
			ft.horainclusao,
			o.idwfprocessoevento,
			o.chaves,
			o.valores,
			(o.chaves->>'idproduto')::bigint as idproduto
		from
			wffilatrabalho ft
			inner join wfocorrencia o on o.idwfocorrencia = ft.idwfocorrencia
			inner join wfatividade a on a.idwfatividade = ft.idwfatividade
			inner join wfprocesso p on p.idwfprocesso = a.idwfprocesso
			inner join empresa e on e.idempresa = ft.idempresa
		where
			ft.idusuarioresponsavel = $v{idUsuario}
			and ft.idwfatividaderealizada is null
			and o.idwffilatrabalhofinalizacao is null
			and ft.expirada = 'N'
			and o.expirada = 'N'
			and o.apelidotarefaencaminhamento in (
				'HEAVEN-wfg-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico',
				'HEAVEN-wf-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico'
			)
	)
	select
		wb.idempresa as idempresa,
		wb.empresa as empresa,
		wb.idwfprocesso as idwfprocesso,
		wb.wfprocesso as wfprocesso,
		wb.idwfatividade as idwfatividade,
		wb.wfatividade as wfatividade,
		json_agg(
			json_build_object(
				'idwffilatrabalho', wb.idwffilatrabalho,
				'idwfocorrencia', wb.idwfocorrencia,
				'idempresa', wb.idempresa,
				'empresa', wb.empresa,
				'idproduto', p.idproduto,
				'codigobarras', p.codigobarras,
				'ean', coalesce((
					select json_agg(json_build_object(
						'ean', pe.codigobarras,
						'quantidade', pe.quantidade
					))
					from produtoembalagem pe
					where pe.idproduto = p.idproduto
				), '[]'::json),
				'produto', p.descricao,
				'imagem', p.foto,
				'idwfatividaderealizada', wb.idwfatividaderealizada,
				'datainclusao', wb.datainclusao::varchar,
				'horainclusao', wb.horainclusao,
				
				/* Buscado na hora */
				'idfamilia', f.idfamilia,
				'familia', f.descricao,
				'idgrupo', g.idgrupo,
				'grupo', g.descricao,
				'idsetor', s.idsetor,
				'setor', s.descricao,
				'iddepartamento', d.iddepartamento,
				'departamento', d.descricao,
				'qtdunentrada', p.qtdunentrada,
				
				'classe', cp.classe,
				'valorprecovenda', ppc.valorprecovenda,
				'diassemvenda', (current_date-1) - pr.dataultimavenda,
				'diasentrada', (current_date-1) - pr.dataultimaentrada,
				'dataultimaentrada', to_char(pr.dataultimaentrada, 'yyyy-mm-dd'),
				'dataultimavenda', to_char(pr.dataultimavenda, 'yyyy-mm-dd'),
				'qtdultimaentrada', pr.qtdeultimaentrada,
				'qtdeultimavenda', pr.qtdeultimavenda,
				'valorcustoaquisicao', ppc.valorcustoaquisicao,
				'qtdvendamedia', pg.girodiareal,
				'observacao', coalesce((
					Select ft.observacao 
					From wffilatrabalho ft 
					Where ft.idwffilatrabalho = wb.idwffilatrabalhoanterior
				), ''),
				'fornecedor', (	
					Select
						p.razaosocial
					From
						produtofornecedor pf
						inner join pessoa p on p.idpessoa = pf.idpessoa
					Where
						pf.idproduto = wb.idproduto
						and p.situacao = 'A'
						and p.fornecedor = 'T'
					limit 1
				),
				'qtdestoqueatual', coalesce((
					Select sum(esa.quantidade) 
					From 	
						estoquesaldoatual esa 
						inner join estoquelocal ecl on (ecl.idlocalestoque = esa.idlocalestoque)
					Where 
						esa.idproduto = p.idproduto 
						and esa.idempresa = wb.idempresa 
						and ecl.localvenda = 'S'
				), (wb.valores->>'estoquequantidade')::numeric),
				'qtdestoqueatualcd', coalesce((
					Select sum(esa.quantidade) 
					From 	
						estoquesaldoatual esa 
					Where 
						esa.idproduto = p.idproduto 
						and esa.idempresa in ($v{idempresaCD#0})
				), 0),

				
				/* Vem da geração de fila trabalho */
				'datavalidade', (wb.valores->>'datavalidade')::varchar,
				'qtdproduzido', wb.valores->>'qtdproduzido',
				'qtdestoquecorreta', wb.valores->>'qtdestoquecorreta',
				'datavencimento', (wb.valores->>'datavencimento')::varchar,
				'dataprevisaosaida', (wb.valores->>'dataprevisaosaida')::varchar,
				'classificacao', wb.valores->>'classificacao',
				'qtdeabastecimento', wb.valores->>'qtdeabastecimento',
				'qtdeabastecer', wb.valores->>'ruptura',
				'saldoestoquedataproxima', wb.valores->>'saldoestoquedataproxima',
				'diasparavencimento', wb.valores->>'diasparavencimento',
				'qtdrevisada', wb.valores->>'qtdrevisada',
				'datavencimentorevisada', (wb.valores->>'datavencimentorevisada')::varchar,
				'qtdvendidoaposconferencia', wb.valores->>'qtdvendidoaposconferencia',
				'estoquequantidade', wb.valores->>'estoquequantidade',
				'qtdultinventario', wb.valores->>'qtdultinventario',
				'qtdproducaobandeja', wb.valores->>'qtdproducaobandeja',
				'percentualabastecimento', wb.valores->>'percentualabastecimento',
				'capacidade', wb.valores->>'capacidade'
			)
		) as produtos
		
		,coalesce((
			Select
				json_agg(
					json_build_object(
						'idwfatividaderealizada', ar.idwfatividaderealizada,
						'atividaderealizada', ar.descricao || coalesce(' -> ' || a2.descricao, ''),
						'tiposituacao', ar.tiposituacao
					)
				) as atividadeselegiveis
			from
				wfatividaderealizada ar
				left join wfatividade a2 on a2.idwfatividade = ar.idwfatividadeproxima
			Where
				ar.idwfatividade = wb.idwfatividade
		), '[]') as atividadeselegiveis
		/* Columns */
		,json_build_array(
			json_build_object(
				'label', 'Produto',
				'icon', 'fa-solid fa-tags',
				'itens', json_build_array(
					json_build_object('key', 'produto', 'label', 'Produto', 'type', 'input', 'searchable', true, 'sortable', true, 'defaultVisible', true),
					json_build_object('key', 'idproduto', 'label', 'ID Produto', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-genderless', 'defaultVisible', true),
					json_build_object('key', 'codigobarras', 'label', 'Código barras', 'type', 'input', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-barcode', 'defaultVisible', true),
					json_build_object('key', 'classe', 'label', 'Classe', 'type', 'multipleSelect', 'options', ARRAY['A', 'B', 'C'], 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-layer-group'),
					json_build_object('key', 'fornecedor', 'label', 'Fornecedor', 'type', 'input', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-truck-fast')
				)
			),
			json_build_object(
				'label', 'Mercadológicos',
				'icon', 'fa-solid fa-layer-group',
				'itens', json_build_array(
					json_build_object('key', 'departamento', 'label', 'Departamento', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'setor', 'label', 'Setor', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'grupo', 'label', 'Grupo', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building'),
					json_build_object('key', 'familia', 'label', 'Família', 'type', 'input', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-building')
				)
			),
			json_build_object(
				'label', 'Datas',
				'icon', 'fa-solid fa-calendar-days',
				'itens', json_build_array(
					json_build_object('key', 'datainclusao', 'label', 'Data Inclusão', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-plus', 'defaultVisible', true),
					json_build_object('key', 'diassemvenda', 'label', 'Dias sem venda', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'diasentrada', 'label', 'Dias entrada', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'dataultimavenda', 'label', 'Data última venda', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days'),
					json_build_object('key', 'dataultimaentrada', 'label', 'Data última entrada', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-day'),
					json_build_object('key', 'datavalidade', 'label', 'Data validade', 'type', 'input', 'inputType', 'date', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-calendar-xmark'),
					json_build_object('key', 'datavencimento', 'label', 'Dt. Venc.', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-xmark', 'defaultVisible', true),
					json_build_object('key', 'diasparavencimento', 'label', 'Dias p/ Venc.', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-days', 'defaultVisible', true),
					json_build_object('key', 'datavencimentorevisada', 'label', 'Dt. Venc. Revisada', 'type', 'date', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-calendar-check', 'defaultVisible', true)
				)
			),
			json_build_object(
				'label', 'Valores',
				'icon', 'fa-solid fa-money-bill-wave',
				'itens', json_build_array(
					json_build_object('key', 'valorprecovenda', 'label', 'Valor preço venda', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-money-bill-wave', 'defaultVisible', true),
					json_build_object('key', 'valorcustoaquisicao', 'label', 'Valor custo aquisição', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-hand-holding-dollar')
				)
			),
			json_build_object(
				'label', 'Quantidade',
				'icon', 'fa-solid fa-scale-balanced',
				'itens', json_build_array(
					json_build_object('key', 'qtdultimaentrada', 'label', 'Quantidade última entrada', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dolly'),
					json_build_object('key', 'qtdeultimavenda', 'label', 'Quantidade última venda', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dollar-sign'),
					json_build_object('key', 'qtdvendamedia', 'label', 'Quantidade venda média', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-cart-shopping'),
					json_build_object('key', 'qtdproducaobandeja', 'label', 'Quantidade produção bandeja', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-kitchen-set'),
					json_build_object('key', 'capacidade', 'label', 'Capacidade', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-cubes'),
					json_build_object('key', 'qtdunentrada', 'label', 'Quantidade unidade entrada', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-dolly'),
					json_build_object('key', 'qtdproduzido', 'label', 'Quantidade produzido', 'type', 'input', 'inputType', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-kitchen-set'),
					json_build_object('key', 'qtdrevisada', 'label', 'Qtd. Revisada', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-clipboard-check', 'defaultVisible', true),
					json_build_object('key', 'qtdvendidoaposconferencia', 'label', 'Qtd. Vendido Após Conf.', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-cart-shopping', 'defaultVisible', true)
				)
			),
			json_build_object(
				'label', 'Estoque',
				'icon', 'fa-solid fa-boxes-stacked',
				'itens', json_build_array(
					json_build_object('key', 'qtdestoqueatual', 'label', 'Est. Atual', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked', 'defaultVisible', true),
					json_build_object('key', 'saldoestoquedataproxima', 'label', 'Saldo Est. (Dt. Próx.)', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked', 'defaultVisible', true),
					json_build_object('key', 'estoquequantidade', 'label', 'Estoque quantidade', 'type', 'inputNumber', 'searchable', true, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked'),
					json_build_object('key', 'percentualabastecimento', 'label', 'Percentual abastecimento', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-percent'),
					json_build_object('key', 'qtdeabastecer', 'label', 'Quantidade abastecer', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-box-open'),
					json_build_object('key', 'qtdultinventario', 'label', 'Quantidade último inventário', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-boxes-packing'),
					json_build_object('key', 'qtdestoqueatualcd', 'label', 'Estoque atual CD', 'type', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-warehouse'),
					json_build_object('key', 'qtdestoquecorreta', 'label', 'Quantidade estoque correto', 'type', 'input', 'inputType', 'inputNumber', 'searchable', false, 'sortable', true, 'icon', 'fa-solid fa-boxes-stacked')
				)
			)
		) as groupcolumns
	from
		wbase wb
		inner join produto p on p.idproduto = wb.idproduto
		left join familia f on f.idfamilia = p.idfamilia
		left join grupo g on g.idgrupo = p.idgrupo
		left join setor s on s.idsetor = p.idsetor
		left join departamento d on d.iddepartamento = p.iddepartamento
		left join classeproduto cp on (
			cp.idempresa = wb.idempresa
			and cp.idproduto = p.idproduto
			and cp.idmercadologico = '0' /* #! 0 = Geral, Não é separado por mercadológico */
			and cp.tipoanalise = 'G' /* #! Classificação do produto por quantidade de saída */
		)
		left join produtoresumo pr on (pr.idproduto = p.idproduto and pr.idempresa = wb.idempresa)
		left join produtogiro pg on (pg.idproduto = p.idproduto and pg.idempresa = wb.idempresa and pg.dias = 90 and pg.tipogiro = 'V')
		left join produtoprecocusto ppc on (ppc.idproduto = p.idproduto and ppc.idempresa = wb.idempresa)
	group by
		wb.idempresa
		,wb.empresa
		,wb.idwfprocesso
		,wb.wfprocesso
		,wb.idwfatividade
		,wb.wfatividade
	order by
		wb.wfprocesso
		,wb.wfatividade
	sql_var(sqlAtividades) sql_props(lower_labels);

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> msgBuilder.setContentEncoding('gzip');
	$> msgBuilder.setCharset('UTF-8');
	$> sb.append('{"atividades":[').append(msgBuilder.sqlVarToJSON('sqlAtividades')).append(']}');
</script_function>

<script_function name="update">
	~write_exec_log;
	set run = ''+execScript.getTarefaExecucao().setObs('update -  $v{usuario}');

	set msg1 = 'Salvo com sucesso.';
	set msg2 = 'Erro ao salvar.';
	
	connect $v{ds_bridge};

	begin_transaction ;
		sql_exec SET LOCAL var.exec_id = '$v{execId}';

		run_script_java_groovy update;
		if execScript.getValueVar('response').contains(execScript.getValueVar('msg2'));
			rollback;
			stop_if true;
		end_if;
	commit ;

	<script_java_groovy name="update">
		import groovy.json.JsonSlurper;
		import bdo.util.SQLUtilX;

		def atividade = new JsonSlurper().parseText(execScript.getValueVar('wffilatrabalho'));

		String execId = execScript.getValueVar('execId');
		String dataAtual = execScript.getValueVar('dataAtual');
		String horaAtual = execScript.getValueVar('dataAtual"datetime:HH:mm:ss"');

		Boolean hasAtividadeFinalizacao = false;
		StringBuilder idWFFilatrabalhoFinalizacao = new StringBuilder();

		String msg1 = execScript.getValueVar('msg1');
		String msg2 = execScript.getValueVar('msg2');
		
		SQLUtilX sqlUtilX = new SQLUtilX('wffilatrabalho', 'idwfatividaderealizada, observacao, idtarefaexecucaoatividaderealizada, dataatividaderealizada, horaatividaderealizada', 'idwffilatrabalho');
		sqlUtilX.setConnectionX(execScript.getConnection());

		sqlUtilX.setInt(null)
				.setString(null)
				.setInt(execId)
				.setDate(dataAtual)
				.setString(horaAtual);
				
		String response = '';
		Map<Integer, String> tiposSituacaoPorAtividade = new HashMap<>();

		for (obj in atividade.encaminhamentos) {
			if (obj.idwfatividadeencaminhamento) {
				Integer idWFAtividadeRealizada = (obj.idwfatividadeencaminhamento as Number).intValue();

				if (!tiposSituacaoPorAtividade.containsKey(idWFAtividadeRealizada)) {
					def statement = execScript.getConnection().prepareStatement('''
						select tiposituacao
						from wfatividaderealizada
						where idwfatividaderealizada = ?
					''');
					def resultSet = null;

					try {
						statement.setInt(1, idWFAtividadeRealizada);
						resultSet = statement.executeQuery();
						tiposSituacaoPorAtividade.put(
							idWFAtividadeRealizada,
							resultSet.next() ? resultSet.getString('tiposituacao') : ''
						);
					} finally {
						if (resultSet != null) {
							resultSet.close();
						}
						statement.close();
					}
				}

				if ('F'.equals(tiposSituacaoPorAtividade.get(idWFAtividadeRealizada))) {
					hasAtividadeFinalizacao = true;
					idWFFilatrabalhoFinalizacao.append(obj.idwffilatrabalho).append(',');
				}

				if (obj?.qtdproduzido) {
					obj.observacao = obj.observacao + " | Quantidade produzido: " + obj.qtdproduzido;
				}
				if (obj?.qtdestoquecorreta) {
					obj.observacao = obj.observacao + " | Quantidade estoque correto: " + obj.qtdestoquecorreta;
				}
				if (obj?.datavalidade) {
					obj.observacao = obj.observacao + " | Data validade: " + obj.datavalidade;
				}

				sqlUtilX.setIndex(-1).setIndexPK(-1)
					.setInt(obj.idwfatividadeencaminhamento)
					.setString(obj.observacao)
					.setIntPK(obj.idwffilatrabalho);
					
				response = sqlUtilX.update(msg1, msg2);
			}

			if (response.contains(msg2)) {
				break;
			}
		}

		if (idWFFilatrabalhoFinalizacao.length() > 0 && idWFFilatrabalhoFinalizacao.charAt(idWFFilatrabalhoFinalizacao.length() - 1) == ',') {
			idWFFilatrabalhoFinalizacao.deleteCharAt(idWFFilatrabalhoFinalizacao.length() - 1);
		}

		execScript.addVar('response', response);
		execScript.addVar('hasAtividadeFinalizacao', hasAtividadeFinalizacao);
		execScript.addVar('idWFFilatrabalho', idWFFilatrabalhoFinalizacao.toString());

		return true;
	</script_java_groovy>

	if '$v{hasAtividadeFinalizacao}'.equals('true');
		# Finaliza as ocorrências
		$include{script:HEAVEN-wfg-finaliza-wfocorrencia-include}include
	end_if;

	# Gera fila trabalho
	$include{
		script:HEAVEN-wfg-gera-wffilatrabalho-sequencia-include, 
		"'HEAVEN-wfg-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico'"
	}include

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> sb.append('$v{response}');
</script_function>

<script_function name="getMercadologicos">
	~not_save_exec;
	set run = ''+execScript.getTarefaExecucao().setObs('GET - getMercadologicos');

	connect $v{ds_bridge};
	
	#######################  
	# Busca os Parâmetros #   
	####################### 
	 
	sql 
	WITH mercadologicos AS (
		SELECT DISTINCT
			p.iddepartamento,
			p.idsetor,
			p.idgrupo,
			p.idfamilia
		FROM produto p
		WHERE p.situacao = 'A'
	)
	SELECT json_agg(dep ORDER BY dep.label) AS mercadologicos
	FROM (
	SELECT 
		d.iddepartamento AS value,
		d.descricao      AS label,
		COALESCE((
		SELECT json_agg(DISTINCT
			jsonb_build_object(
			'value', s.idsetor,
			'label', s.descricao,
			'grupos', COALESCE((
				SELECT json_agg(DISTINCT
				jsonb_build_object(
					'value', g.idgrupo,
					'label', g.descricao,
					'familias', COALESCE((
					SELECT json_agg(DISTINCT
						jsonb_build_object(
						'value', f.idfamilia,
						'label', f.descricao
						)
					)
					FROM mercadologicos m4
					JOIN familia f ON f.idfamilia = m4.idfamilia
					WHERE m4.idgrupo = g.idgrupo
					), '[]'::json)
				)
				)
				FROM mercadologicos m3
				JOIN grupo g ON g.idgrupo = m3.idgrupo
				WHERE m3.idsetor = s.idsetor
			), '[]'::json)
			)
		)
		FROM mercadologicos m2
		JOIN setor s ON s.idsetor = m2.idsetor
		WHERE m2.iddepartamento = d.iddepartamento
		), '[]'::json) AS setores
	FROM departamento d
	WHERE EXISTS (
		SELECT 1
		FROM mercadologicos m
		WHERE m.iddepartamento = d.iddepartamento
	)
	) dep
	sql_var(sqlMercadologicos);
	  
	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> msgBuilder.setContentEncoding('gzip');
	$> msgBuilder.setCharset('UTF-8');
	$> sb.append('[').append(msgBuilder.sqlVarToJSON('sqlMercadologicos')).append(']');
</script_function>

<script_function name="getInfoUsuario">
	~write_exec_log;
	set run = ''+execScript.getTarefaExecucao().setObs('GET - getInfoUsuario');

	connect $v{ds_bridge};

	sql 
	Select
		u.idusuario
		,u.usuario
		,u.nome
		,c.email
		,c.telefonecelular
	From 
		usuario u
		left join colaborador c on (c.idcolaborador = u.idcolaborador)
	Where 
		u.idusuario = $v{idUsuario}
	sql_var(sqlInfoUsuario);

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> msgBuilder.setContentEncoding('gzip');
	$> msgBuilder.setCharset('UTF-8');
	$> sb.append(msgBuilder.sqlVarToJSON('sqlInfoUsuario'));
</script_function>