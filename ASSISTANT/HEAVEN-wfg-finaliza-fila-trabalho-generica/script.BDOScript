# versao 1.0

# Alterações:
# |    Data    | Programador | Solicitante | Caso Mantis | Descrição 
# | 28/04/2026 | Bernardo    | 			   | 38535   	 | Criação.

~write_exec_log;

###############
# Variáveis a serem salvas em TAREFAEXECUCAOVALOR
###############

connect $v{ds_bridge};

sql 
Select
	'$v{WFProcesso_idWFProcesso#}' as "WFProcesso_idWFProcesso"
	,'$v{WFProcessoEvento_idWFProcessoEvento#}' as "WFProcessoEvento_idWFProcessoEvento"
	,'$v{idWFAtividadeRealizadaFinalizacao#}' as "idWFAtividadeRealizadaFinalizacao"
	,'$v{vendaDiaAnterior#0}' as "vendaDiaAnterior"
	,'$v{estoqueZero#false}' as "estoqueZero"
	,'$v{estoqueNegativo#false}' as "estoqueNegativo"
	,'$v{estoquePositivo#false}' as "estoquePositivo"
	,'$v{estoquePositivoPontoExposicao#false}' as "estoquePositivoPontoExposicao"
	,'$v{pontoExposicao#}' as "pontoExposicao"
	,'$v{pesobrutoFiltro#}' as "pesobrutoFiltro"
	,'$v{pesoliquidoFiltro#}' as "pesoliquidoFiltro"
	,'$v{naoPossuiCodigoBarras#false}' as "naoPossuiCodigoBarras"
save_rows(1,1);

#############################
# Filtros de Dias Sem Venda #
set filtroVendaDiaAnterior = '$v{vendaDiaAnterior#false}'.equals("false") ? "" : "and exists (
	Select 	null
	From produtoresumo pr
	Where
		pr.idempresa = x.idempresa
		and pr.idproduto = p.idproduto
		and pr.dataultimavenda >= (current_date - 1)
)";

##################
# Filtros de Peso #
set filtroPesoBruto = '$v{pesobrutoFiltro#}'.equals("") ? "" : ('$v{pesobrutoFiltro#}'.equals("EQ_ZERO") ? "or coalesce(p.pesobruto, 0) = 0" : ('$v{pesobrutoFiltro#}'.equals("GT_ZERO") ? "or coalesce(p.pesobruto, 0) > 0" : ""));
set filtroPesoLiquido = '$v{pesoliquidoFiltro#}'.equals("") ? "" : ('$v{pesoliquidoFiltro#}'.equals("EQ_ZERO") ? "or coalesce(p.pesoliquido, 0) = 0" : ('$v{pesoliquidoFiltro#}'.equals("GT_ZERO") ? "or coalesce(p.pesoliquido, 0) > 0" : ""));

set filtroGeralPesoProduto = !"$v{filtroPesoBruto}".equals("") || !"$v{filtroPesoLiquido}".equals("") ? """
	and (
		1=0
		$v{filtroPesoBruto}
		$v{filtroPesoLiquido}
	)
""" : "";

############################
# Filtro Código de Barras #
set filtroNaoPossuiCodigoBarras = '$v{naoPossuiCodigoBarras#false}'.equals("false") ? "" : "or coalesce(p.codigobarras, 0) = 0";

###########
# Estoque #
set filtroEstoqueZero = '$v{estoqueZero#false}'.equals("false") ? "" : "or sum(esa.quantidade) = 0.";
set filtroEstoqueNegativo = '$v{estoqueNegativo#false}'.equals("false") ? "" : "or sum(esa.quantidade) < 0.";
set filtroEstoquePositivo = '$v{estoquePositivo#false}'.equals("false") ? "" : "or sum(esa.quantidade) > 0.";
set filtroEstoquePositivoPontoExposicao = '$v{estoquePositivoPontoExposicao#false}'.equals("false") ? "" : "or sum(ppe.quantidadeestoque) > 0.";
set filtroGeralEstoque = !"$v{filtroEstoquePositivoPontoExposicao}".equals("") || !"$v{filtroEstoqueZero}".equals("") || !"$v{filtroEstoqueNegativo}".equals("") || !"$v{filtroEstoquePositivo}".equals("") ? """
	and (
		1=0
		$v{filtroEstoqueZero}
		$v{filtroEstoqueNegativo}
		$v{filtroEstoquePositivo}
		$v{filtroEstoquePositivoPontoExposicao}
	)
""" : "";

######################
# Ponto de Exposição #
set filtroPontoExposicao = '$v{pontoExposicao#}'.equals("") ? "" : "and ppe.idpontoexposicao in ($v{pontoExposicao#})";

#########
# Joins #
set joinFiltroEstoque = !"$v{filtroEstoqueZero}".equals("") || !"$v{filtroEstoqueNegativo}".equals("") || !"$v{filtroEstoquePositivo}".equals("") ? """
	inner join estoquesaldoatual esa on (esa.idempresa = x.idempresa and esa.idproduto = p.idproduto)
	inner join estoquelocal el on (el.idlocalestoque = esa.idlocalestoque)
""" : "";
set joinProdutoPontoExposicao = !"$v{filtroEstoquePositivoPontoExposicao}".equals("") || !"$v{filtroPontoExposicao}".equals("") ? """
	inner join produtopontoexposicao ppe on (ppe.idproduto = p.idproduto and ppe.idempresa = x.idempresa)
""" : "";

#######################################
# SQL Finalização de Fila de Trabalho #
#######################################

connect $v{ds_bridge};

begin_transaction;
	sql_exec SET LOCAL var.exec_id = '$v{execId}';

	sql_exec 
	With 
		atividadeRealizadaFinalizacao as (
			Select
				ar.idwfatividade
				,ar.idwfatividaderealizada
			From
				wfatividaderealizada ar
			Where
				ar.idwfatividaderealizada = $v{idWFAtividadeRealizadaFinalizacao#0}
		),
		ocorrenciasElegiveis as (
			Select
				x.idempresa
				,x.idproduto
				,x.idwfocorrencia
				,x.idwffilatrabalho as idwffilatrabalhoanterior
			From
				(
				Select
					o.idempresa
					,(o.chaves->>'idproduto')::bigint as idproduto
					,o.idwfocorrencia
					,ft.idwffilatrabalho
					# -- Sequência de trabalho daquela ocorrência.
					,dense_rank() over (partition by o.idwfocorrencia order by ft.idwffilatrabalho desc) as sequencia
				From
					wfocorrencia o
					inner join wffilatrabalho ft on (ft.idwfocorrencia = o.idwfocorrencia)
				Where
					o.idwfprocessoevento = $v{WFProcessoEvento_idWFProcessoEvento}
					and o.idwffilatrabalhofinalizacao is null
					and o.expirada = 'N'
				) x
				inner join produto p on (p.idproduto = x.idproduto)
				$v{joinFiltroEstoque}
				$v{joinProdutoPontoExposicao}
			Where
				x.sequencia = 1 -- # Última fila de trabalho

				/* Filtros de Dias Sem Venda */
				$v{filtroVendaDiaAnterior}

				/* Filtros de Peso */
				$v{filtroGeralPesoProduto}
				
				/* Filtros de Estoque Ponto de Exposição */
				$v{filtroPontoExposicao}

				/* Filtro Não possui Código de Barras */
				$v{filtroNaoPossuiCodigoBarras}
			Group by
				x.idempresa
				,x.idproduto
				,x.idwfocorrencia
				,x.idwffilatrabalho
				,p.codigobarras
			Having
				1=1

				/* Filtros de Estoque */
				$v{filtroGeralEstoque}

				/* Filtros de Estoque Ponto de Exposição */
				$v{filtroEstoquePositivoPontoExposicao}

				/* Filtro Não possui Código de Barras */
				$v{filtroNaoPossuiCodigoBarras}
		)
	Insert into WFFilatrabalho
		(idwfocorrencia, idempresa, idwfatividade, idwfatividaderealizada, idwffilatrabalhoanterior, observacao, datainclusao, horainclusao, idtarefaexecucaoinclusao, idtarefaexecucaoatividaderealizada)
	Select
		o.idwfocorrencia
		,o.idempresa
		,ar.idwfatividade
		,ar.idwfatividaderealizada
		,o.idwffilatrabalhoanterior

		,'Finalização automática da fila de trabalho, de acordo como configurado no nó de cadastro WFG.' as observacao
		,'$v{dataAtual}'::date as datainclusao
		,'$v{dataAtual"datetime:HH:mm:ss"}'::text as horainclusao
		,$v{execId} as idtarefaexecucaoinclusao
		,$v{execId} as idtarefaexecucaoatividaderealizada
		
	From
		ocorrenciasElegiveis o
		inner join atividadeRealizadaFinalizacao ar on (ar.idwfatividaderealizada = $v{idWFAtividadeRealizadaFinalizacao#0})
	;

commit;

# Finaliza as ocorrências
$include{script:HEAVEN-wfg-finaliza-wfocorrencia-include}include

# Gera fila trabalho
$include{
	script:HEAVEN-wfg-gera-wffilatrabalho-sequencia-include, 
	"execScript.getValueVar('WFOcorrencia_apelidoTarefaEncaminhamento')"
}include