<style>
	.apps-panel {
		width: 100%;
		min-height: calc(100vh - 40px);
		padding: 28px 20px 40px;
		box-sizing: border-box;
		background: linear-gradient(160deg, #f0f4f8 0%, #e8eef5 45%, #f7f9fc 100%);
	}

	.apps-panel__header {
		max-width: 720px;
		margin: 0 auto 28px;
		text-align: center;
	}

	.apps-panel__title {
		margin: 0 0 6px;
		font-size: 1.55rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #1a2b3c;
	}

	.apps-panel__subtitle {
		margin: 0;
		font-size: 0.95rem;
		color: #5a6d7e;
	}

	.apps-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 16px;
		max-width: 720px;
		margin: 0 auto;
	}

	.apps-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 14px;
		min-height: 148px;
		padding: 22px 16px;
		text-decoration: none !important;
		color: #1a2b3c !important;
		background: #fff;
		border: 1px solid rgba(26, 43, 60, 0.08);
		border-radius: 16px;
		box-shadow: 0 4px 14px rgba(26, 43, 60, 0.06);
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
		-webkit-tap-highlight-color: transparent;
	}

	.apps-card:hover,
	.apps-card:focus {
		transform: translateY(-3px);
		border-color: rgba(26, 43, 60, 0.14);
		box-shadow: 0 10px 24px rgba(26, 43, 60, 0.12);
		outline: none;
	}

	.apps-card:active {
		transform: translateY(-1px);
	}

	.apps-card__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 14px;
		font-size: 1.55rem;
		color: #fff;
		overflow: hidden;
	}

	.apps-card__icon img {
		display: block;
		width: 34px;
		height: 34px;
		object-fit: contain;
	}

	.apps-card__icon--fila {
		background: linear-gradient(145deg, #f3ebff 0%, #e8d8ff 100%);
	}

	/* Exemplo para próximos apps:
	.apps-card__icon--inventario { background: linear-gradient(145deg, #0f9d7a 0%, #0a6e56 100%); }
	.apps-card__icon--producao  { background: linear-gradient(145deg, #e67e22 0%, #c45d0a 100%); }
	*/

	.apps-card__label {
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.25;
		text-align: center;
	}

	.apps-card__hint {
		font-size: 0.78rem;
		font-weight: 400;
		color: #6b7c8d;
		text-align: center;
		line-height: 1.3;
	}

	@media (max-width: 420px) {
		.apps-panel {
			padding: 20px 14px 32px;
		}

		.apps-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.apps-card {
			min-height: 132px;
			padding: 18px 12px;
			border-radius: 14px;
		}
	}
</style>

<!--section-->

