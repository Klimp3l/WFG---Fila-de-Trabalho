write_exec_log;
	
connect $v{ds_bridge};

sql 
Select
	e.idempresa||'.'||a.idwfatividade as idwfatividade
	,e.apelido||' - '||a.descricao as descr
From
	wfatividade a
	inner join wfprocesso p on (p.idwfprocesso = a.idwfprocesso)
	cross join empresa e
Where
	p.idwfprocesso = 30002 /* #! Produtos Próximos do Vencimento */
	and exists (
		Select 	NULL
		From 	wffilatrabalho f
				inner join wfocorrencia o on (o.idwfocorrencia = f.idwfocorrencia)
		where 	f.idusuarioresponsavel = $v{idUsuario} 
				and f.idempresa = e.idempresa
				and f.idwfatividade = a.idwfatividade
				and f.expirada = 'N'
				and f.idwfatividaderealizada is null 
				and o.expirada = 'N'
				and o.idwffilatrabalhofinalizacao is null
				and o.apelidotarefaencaminhamento = 'HEAVEN-wf-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico'
	)
Order by 2
sql_var(sql_idwfatividade);


stop_if $c{idwfatividade:count} == 0;

parameter idwfatividade label="Atividade" type="string" values="sql_var(sql_idwfatividade)" default="$c{idwfatividade[0]}";

stop_if '$v{idwfatividade#}'.equals('');

set run = ""+execScript.getTarefaExecucao().setObs('$v{usuario} - main');

set idempresa = '$v{idwfatividade}'.split('[.]')[0];
set idwfatividade = '$v{idwfatividade}'.split('[.]')[1];

sql select * from wfatividade where idwfatividade = $v{idwfatividade} sql_var(sql_wfatividade);


sql 
Select  /* $v{apelido} | $v{execId}  */
	x.*
	,x.qtdrevisada - x.qtdvendidoaposconferencia as saldo
From (
	Select
		cast(ft.idwffilatrabalho as varchar(255)) as recid
		,o.idwfocorrencia
		,ft.idwffilatrabalho
		,to_char(ft.datainclusao ,'dd/mm/yyyy') as datainclusao
		,ft.horainclusao
		,ft.idwfatividaderealizada
		,ft.idwfocorrencia
		,ft.idwfatividade

		,p.codigobarras
		,p.idproduto
		,p.descricao as produto
		,f.idfamilia
		,f.descricao as familia
		,g.idgrupo
		,g.descricao as grupo
		,s.idsetor
		,s.descricao as setor
		,d.iddepartamento
		,d.descricao as departamento
		,x.numeronf

		,(o.valores->>'valorprecovenda')::numeric as valorprecovendaanterior


		,(Case
			when ft.idwfatividade = 30010
				then coalesce((o.valores->>'qtdrevisada')::numeric,
					(Case
						when ft.idwfatividade = 30010
						then coalesce((o.valores->>'saldoestoquedataproximaposenc')::numeric, x.saldoestoquedataproxima)
						else x.saldoestoquedataproxima
					end)
				)
			else (o.valores->>'qtdrevisada')::numeric 
		end) as qtdrevisada

		,(Case
			when ft.idwfatividade = 30010
				then to_char(coalesce((Case
				when length((o.valores->>'datavencimentorevisada')::varchar) = 8 and not (o.valores->>'datavencimentorevisada')::varchar like '%/%' then to_date((o.valores->>'datavencimentorevisada')::varchar, 'ddMMyyyy')
				when length((o.valores->>'datavencimentorevisada')::varchar) = 8 and (o.valores->>'datavencimentorevisada')::varchar like '%/%' then to_date((o.valores->>'datavencimentorevisada')::varchar, 'dd/MM/yy')
				when length((o.valores->>'datavencimentorevisada')::varchar) = 10 then to_date((o.valores->>'datavencimentorevisada')::varchar, 'dd/MM/yyyy')
			else null end), x.datavencimento), 'dd/MM/yyyy')
			else to_char((Case
				when length((o.valores->>'datavencimentorevisada')::varchar) = 8 and not (o.valores->>'datavencimentorevisada')::varchar like '%/%' then to_date((o.valores->>'datavencimentorevisada')::varchar, 'ddMMyyyy')
				when length((o.valores->>'datavencimentorevisada')::varchar) = 8 and (o.valores->>'datavencimentorevisada')::varchar like '%/%' then to_date((o.valores->>'datavencimentorevisada')::varchar, 'dd/MM/yy')
				when length((o.valores->>'datavencimentorevisada')::varchar) = 10 then to_date((o.valores->>'datavencimentorevisada')::varchar, 'dd/MM/yyyy')
			else null end), 'dd/MM/yyyy')
		end) as datavencimentorevisada

		/* #! qtd itens vendidos após a conferencia */
		,(	Select	sum(mr.quantidade)
			From	movimentoresumo mr
					inner join tipooperacao op on (op.idtipooperacao = mr.idtipooperacao)
			Where	mr.idempresa = o.idempresa
					and mr.idproduto = (o.chaves->>'idproduto')::int
					and mr.datamovimento > (Select ft2.dataatividaderealizada from wffilatrabalho ft2 where ft2.idwffilatrabalho = ft.idwffilatrabalhoanterior)
					and op.categoria = 'VEN'
					and mr.datamovimento <= current_date
		) as qtdvendidoaposconferencia

		/* #! qtd itens vendidos ontem */
		,(	Select	sum(mr.quantidade)
			From	movimentoresumo mr
					inner join tipooperacao op on (op.idtipooperacao = mr.idtipooperacao)
			Where	mr.idempresa = o.idempresa
					and mr.idproduto = (o.chaves->>'idproduto')::int
					and op.categoria = 'VEN'
					and mr.datamovimento = current_date-1
		) as qtdvendidoontem

		,(Select ft2.observacao from wffilatrabalho ft2 where ft2.idwffilatrabalho = ft.idwffilatrabalhoanterior) as observacaoanterior


		/* #! VALORES */
		,x.estoqueanterior
		,x.quantidaderecebida
		,x.estoqueinicial
		,x.quantidadevendida

		--,x.saldoestoquedataproxima
		,(Case
			when ft.idwfatividade = 30010
			then coalesce((o.valores->>'saldoestoquedataproximaposenc')::numeric, x.saldoestoquedataproxima)
			else x.saldoestoquedataproxima
		end) as saldoestoquedataproxima

		,x.estoqueatual
		,x.estoquedias
		,(x.datavencimento - current_date ) as diasparavencimento    /* x.diasparavencimento */
		,x.valorprecovenda
		,x.valorcustoaquisicao
		,x.margempraticada
		,to_char(x.datamovimento, 'dd/MM/yyyy') as dataentrada
		,to_char(x.datavencimento, 'dd/MM/yyyy') as datavencimento
		,to_char(x.dataultimavenda, 'dd/MM/yyyy') as dataultimavenda
	From
		wffilatrabalho ft 
		inner join wfocorrencia o on (o.idwfocorrencia = ft.idwfocorrencia)
		inner join produto p on (p.idproduto = (o.chaves->>'idproduto')::bigint)
		left join tbItensVencimento x on (
			x.idempresa = ft.idempresa
			and x.idproduto = p.idproduto
			and x.numeronf = (o.chaves->>'numeronf')::bigint
			and (
				coalesce(
					nullif(o.chaves->>'datavencimento', '')::date,
					nullif(o.valores->>'datavencimentoinclusao', '')::date
				) is null
				or x.datavencimento = coalesce(
					nullif(o.chaves->>'datavencimento', '')::date,
					nullif(o.valores->>'datavencimentoinclusao', '')::date
				)
			)
		)
		left join familia f on (f.idfamilia = p.idfamilia)
		left join grupo g on (g.idgrupo = p.idgrupo)
		left join setor s on (s.idsetor = p.idsetor)
		left join departamento d on (d.iddepartamento = p.iddepartamento)
	Where
		ft.idusuarioresponsavel = $v{idUsuario} 
		and ft.idempresa = $v{idempresa}
		and ft.idwfatividade = $v{idwfatividade}
		and ft.expirada = 'N'
		and ft.idwfatividaderealizada is null
		and o.idwffilatrabalhofinalizacao is null
		and o.expirada = 'N'
		and o.apelidotarefaencaminhamento = 'HEAVEN-wf-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico'
	) x
sql_var(sql_filadetrabalho);


sql 
Select
	ar.idwfatividaderealizada as "id"
	,ar.descricao||coalesce(' -> '||a.descricao, '') as "text"
	,ar.idwfatividaderealizada as idwfatividaderealizada
	,ar.descricao||coalesce(' -> '||a.descricao, '') as atividaderealizada
From
	wfatividaderealizada ar
	left join wfatividade a on (a.idwfatividade = ar.idwfatividadeproxima)
Where
	ar.idwfatividade = $v{idwfatividade}
Order by 2
sql_var(sql_idwfatividaderealizada);


set iddepartamento = '$c{iddepartamento:list#}'.trim().equals('') ? '-1' : '$c{iddepartamento:list#}';
sql 
Select
	iddepartamento as "id"
	,descricao as "text"
	,iddepartamento
	,descricao as departamento
From
	departamento 
Where
	iddepartamento in ($v{iddepartamento}) 
sql_var(sql_iddepartamento);


<script_function name="update">
	~not_save_exec;
	write_exec_log;
	set msg1 = 'Salvo com sucesso.';
	set msg2 = 'Erro ao salvar.';

	set run = ""+execScript.getTarefaExecucao().setObs('$v{usuario} - update');

	connect $v{ds_bridge};
	begin_transaction ;
		run_script_java_groovy update;
		if execScript.getValueVar('response').contains(execScript.getValueVar('msg2'));
			rollback;
			stop_if true;
		end_if;
	commit ;


	<script_java_groovy name="update">
		import bdo.util.SQLUtilX;
		import groovy.json.JsonOutput;
		import groovy.json.JsonSlurper;
		import org.postgresql.util.PGobject;
		import groovy.sql.Sql;

		def sql = new Sql(execScript.getConnection());

		def objArray = new JsonSlurper().parseText(execScript.getValueVar('wffilatrabalho'));

		String execId = execScript.getValueVar('execId');
		String dataAtual = execScript.getValueVar('dataAtual');
		String horaAtual = execScript.getValueVar('dataAtual"datetime:HH:mm:ss"');

		String msg1 = execScript.getValueVar('msg1');
		String msg2 = execScript.getValueVar('msg2');

		SQLUtilX sqlUtilX = new SQLUtilX('wffilatrabalho', 'idwfatividaderealizada, observacao, idtarefaexecucaoatividaderealizada, dataatividaderealizada, horaatividaderealizada', 'idwffilatrabalho');
		sqlUtilX.setConnectionX(execScript.getConnection());

//		SQLUtilX suxLog = new SQLUtilX(
//			'giovani_log_wfocorrencia_valores'
//			,'valoresantigo, valoresnovo, idrequisicao'
//			,'idwfocorrencia, idusuarioalteracao, dataalteracao, horaalteracao');
//		suxLog.setConnectionX(execScript.getConnection());

		sqlUtilX.setInt(null)
				.setString(null)
				.setInt(execId)
				.setDate(dataAtual)
				.setString(horaAtual);

		String response = '';
		String idWFFilatrabalho = '0';
		String idWFOcorrencia = '-1';

		SQLUtilX suxOcorrencia = new SQLUtilX('wfocorrencia', 'valores', 'idwfocorrencia');
		suxOcorrencia.setConnectionX(execScript.getConnection());

//		int idRequisicao = sql.firstRow("select coalesce(max(idrequisicao),0)+1 from giovani_log_requisicao")[0];

//		sql.execute("""
//			INSERT INTO giovani_log_requisicao (idrequisicao, request)
//			values(${idRequisicao}, '${execScript.getValueVar('wffilatrabalho').replaceAll('\'', '')}')
//		""");

		for (obj in objArray) {
			if (obj.idwfatividaderealizada) {

				String valores = sql.firstRow("select valores from wfocorrencia where idwfocorrencia = ${obj.idwfocorrencia}")[0];
				valores = valores == null ? '{}' : valores;
				def objValores = new JsonSlurper().parseText(valores);
				def oldObjValores = objValores;

				objValores.saldoestoquedataproximaposenc = obj.saldoestoquedataproxima;
				objValores.qtdrevisada = obj.qtdrevisada == '' || obj.qtdrevisada == null ? obj.saldoestoquedataproxima : obj.qtdrevisada;
				objValores.datavencimentorevisada = obj.datavencimentorevisada == '' || obj.datavencimentorevisada == null ? obj.datavencimento : obj.datavencimentorevisada;

				PGobject json = new PGobject();
				json.setType('json');
				json.setValue(JsonOutput.toJson(objValores));

				PGobject jsonOld = new PGobject();
				jsonOld.setType('json');
				jsonOld.setValue(JsonOutput.toJson(oldObjValores));

				idWFFilatrabalho += ',' + obj.idwffilatrabalho;
				idWFOcorrencia += ',' + obj.idwfocorrencia;

				sqlUtilX.setIndex(-1)
					.setIndexPK(-1)
					.setInt(obj.idwfatividaderealizada)
					.setString(obj.observacao)
					.setIntPK(obj.idwffilatrabalho);

				response = sqlUtilX.update(msg1, msg2);

				if (response.contains(msg2)) {
					break;
				}
	
				suxOcorrencia.setIndex(-1)
					.setIndexPK(-1)
					.setObject(json)
					.setIntPK(obj.idwfocorrencia);
	
				response = suxOcorrencia.update(msg1, msg2);
	
				if (response.contains(msg2)) {
					break;
				}

//				response = suxLog.setIndex(-1)
//					.setIndexPK(-1)
//					.setObject(jsonOld)
//					.setObject(json)
//					.setInt(idRequisicao)
//					.setIntPK(obj.idwfocorrencia)
//					.setIntPK(Integer.parseInt(execScript.getValueVar('idUsuario')))
//					.setDatePK(dataAtual)
//					.setStringPK(horaAtual)
//					.insertOrUpdate(msg1, msg2);

//				if (response.contains(msg2)) {
//					break;
//				}
			}
		}

		execScript.addVar('response', response);
		execScript.addVar('idWFFilatrabalho', idWFFilatrabalho);
		execScript.addVar('idWFOcorrencia', idWFOcorrencia);

		return true;
	</script_java_groovy>

	if '$v{idWFFilatrabalho#0}'.equals('0');
		set response = '{ "msg": "", "error": "" }';
		stop_if true;
	end_if;

	# Finaliza as ocorrências
	$include{script:HEAVEN-wf-finaliza-wfocorrencia-include}include

	# Gera fila trabalho
	$include{
		script:HEAVEN-wf-gera-wffilatrabalho-sequencia-include, 
		"'HEAVEN-wf-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico'"
	}include

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> sb.append('$v{response}');
</script_function>


<script_function name="addNewProduto">
	~not_save_exec;
	write_exec_log;
	set msg1 = 'Salvo com sucesso.';
	set msg2 = 'Erro ao salvar.';

	set run = ""+execScript.getTarefaExecucao().setObs('$v{usuario} - addNewProduto');

	set WFOcorrencia_apelidoTarefaEncaminhamento = 'HEAVEN-wf-atribui-usuario-responsavel-wffilatrabalho-wfatividade-mercadologico';
	set WFProcessoEvento_idWFProcessoEvento = 30007;

	connect $v{ds_bridge};

	if !'$v{idproduto#}'.equals('');
		sql Select idproduto from produto p where p.idproduto = $v{idproduto};
	end_if;

	if $c{idproduto#0} == 0;
		if !'$v{codigobarras#}'.equals('');
			#sql Select idproduto from produto p where p.codigobarras = $v{codigobarras};
			sql Select idproduto from produtoembalagem p where p.codigobarras = $v{codigobarras} limit 1;
		end_if;
	end_if;

	if $c{idproduto#0} == 0;
		set response = '{ "msg": "$v{msg2}", "error": "Produto com o código de barras $v{codigobarras} não foi encontrado." }';

		stop_if true;
	end_if;

	begin_transaction;
		sql_exec
		With
			ocorrencia as (
				Select 
					$v{WFProcessoEvento_idWFProcessoEvento} as idwfprocessoevento
					,$v{idempresa} as idempresa
					,jsonb_build_object(
						'idproduto', $c{idproduto}
					) as chaves
					,'M' as tipoinclusao
					,'A' as tipoencaminhamento
					,'$v{WFOcorrencia_apelidoTarefaEncaminhamento}' as apelidotarefaencaminhamento
					,jsonb_build_object(
						'qtdrevisada', $v{qtdvencer}::numeric,
						'datavencimentorevisada', '$v{datavencimento}'
					) as valores
					,current_date as datainclusao
					,cast(current_time as char(8)) as horainclusao
					,$v{idUsuario} as idusuarioinclusao
					,$v{execId} as idtarefaexecucaoinclusao
			)
		INSERT INTO WFOcorrencia (idwfprocessoevento, idempresa, chaves, tipoencaminhamento, apelidotarefaencaminhamento, valores, tipoinclusao, datainclusao, horainclusao, idusuarioinclusao, idtarefaexecucaoinclusao)
		Select 	idwfprocessoevento, idempresa, chaves, tipoencaminhamento, apelidotarefaencaminhamento, valores, tipoinclusao, datainclusao, horainclusao, idusuarioinclusao, idtarefaexecucaoinclusao
		From 	ocorrencia
		;
	commit;

	# Gera fila de trabalho inicial
	$include{
		script:HEAVEN-wf-gera-wffilatrabalho-inicial-include, 
		"execScript.getValueVar('WFOcorrencia_apelidoTarefaEncaminhamento')",
		"execScript.getValueVar('WFProcessoEvento_idWFProcessoEvento')"
	}include

	set response = '{ "msg": "$v{msg1}", "error": "" }';

	<!--output-->
	$> msgBuilder.setContentType('application/json');
	$> sb.append('$v{response#}');
</script_function>

<script_function name="export">
#!#######################################################################################################
#!                    ATENÇÃO NUNCA ATIVAR not_save_exec  NESSA SCRIPT_FUNCTION							#
#!          O ARQUIVO EXCEL DEPENDE DO CODIGO DE EXECUÇÃO PARA SER GERADO ! 							#
#!#######################################################################################################

	set run = ""+execScript.getTarefaExecucao().setObs('$v{usuario} - export');

	set wffilatrabalho = execScript.getValueVar('wffilatrabalho').replace("'", "");

	connect $v{ds_bridge};

	sql 
	Select 
		(value->>'iddepartamento') as iddepartamento
		,(value->>'departamento') as departamento
		,(value->>'idsetor') as idsetor
		,(value->>'setor') as setor
		,(value->>'idgrupo') as idgrupo
		,(value->>'grupo') as grupo
		,(value->>'idfamilia') as idfamilia
		,(value->>'familia') as familia
		,(value->>'idproduto') as idproduto
		,(value->>'produto') as produto
		,(value->>'codigobarras') as codigobarras
		,(value->>'numeronf') as numeronf
		,(value->>'valorprecovendaanterior')::numeric as valorprecovendaanterior
		,(value->>'qtdrevisada')::numeric as qtdrevisada
		,(value->>'datavencimentorevisada')::varchar as datavencimentorevisada
		,(value->>'qtdvendidoaposconferencia')::numeric as qtdvendidoaposconferencia
		,(value->>'qtdvendidoontem')::numeric as qtdvendidoontem
		,(value->>'observacaoanterior') as observacaoanterior
		,(value->>'estoqueanterior')::numeric as estoqueanterior
		,(value->>'quantidaderecebida')::numeric as quantidaderecebida
		,(value->>'estoqueinicial')::numeric as estoqueinicial
		,(value->>'quantidadevendida')::numeric as quantidadevendida
		,(value->>'saldoestoquedataproxima')::numeric as saldoestoquedataproxima
		,(value->>'estoqueatual')::numeric as estoqueatual
		,(value->>'estoquedias')::int as estoquedias
		,(value->>'diasparavencimento')::int as diasparavencimento
		,(value->>'valorprecovenda')::numeric as valorprecovenda
		,(value->>'valorcustoaquisicao')::numeric as valorcustoaquisicao
		,(value->>'margempraticada')::numeric as margempraticada
		,(value->>'dataentrada')::varchar as dataentrada
		,(value->>'datavencimento')::varchar as datavencimento
		,(value->>'dataultimavenda')::varchar as dataultimavenda
		,row_number() over() % 2 rn
	From 
		json_array_elements('$v{wffilatrabalho}')
	sql_var(sql);

	xlsx
		<name>filatrabalho</name>
		<template>CLIENTE-wf-ruptura-marcacao-wfatividaderealizada-wffilatrabalho-vencimento.xlsx</template>
		<sqlvars>
			<sqlvar>sql</sqlvar>
		</sqlvars>;

	<!--output-->
	<a href="$xlsx{filatrabalho}"></a>
</script_function>