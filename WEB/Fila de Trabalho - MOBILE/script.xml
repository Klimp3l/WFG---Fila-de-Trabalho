<html>
<head>
	<meta http-equiv="Content-Type" content="text/html;charset=ISO-8859-1">

	<link rel="stylesheet" href="js/bootstrap-3.2.0/css/bootstrap.min.css">
	<link rel="stylesheet" href="js/bootstrap-table-1.8.1/bootstrap-table.min.css">

	<link rel="stylesheet" href="https://code.jquery.com/ui/1.11.0/themes/smoothness/jquery-ui.css">

	<style>
		.row {
			margin: 0 !important;
		}
		.input-lg, .form-horizontal .form-group-lg .form-control {
		    font-size: 1em !important;
		    line-height: normal;
		}
		.fixed-table-container thead th .th-inner {
			white-space: normal;
		}
		.fixed-table-header {
			height: 88px;
		}
		.fixed-table-container {
			height: calc(100vh - 210px);
		}
		th {
		    text-align: center!important;
		}
		
		div#custom-toolbar > * {
			margin: 0 36px;
		}
		
		.includeLoader {
			display: none;
			z-index: 9999;
		}
		.includeLoader.includeSpinner {
		    border: 16px solid #f3f3f3; /* Light grey */
		    border-top: 16px solid #3498db; /* Blue */
		    border-radius: 50%;
		    width: 120px;
		    height: 120px;
		    animation: spin 2s linear infinite;
		    left: calc(50% - 60px);
		    top: calc(50% - 60px);
		    position: fixed;
		}
		.includeLoader.includeBackground {
		    width: 100%;
		    height: 100%;
		    position: fixed;
		    background: #00000059;    
			left: 0;
		    top: 0;
		}
		.includeLoader.includeText {
			left: 40px;
			top: calc(50% - -120px);
			position: fixed;
			color: white;
			font-size: 17px;
			font-weight: bold;
			width: 100%;
			text-align: center;
		}
		@keyframes spin {
		    0% { transform: rotate(0deg); }
		    100% { transform: rotate(360deg); }
		}


		.bootstrap-table .table>thead>tr>th {
		    vertical-align: top !important;
		}
		.fixed-table-header {
		    height: 114px !important;
		}
	</style>

</head>
<body>

	<div class="includeLoader includeBackground"></div>
	<div class="includeLoader includeSpinner"></div>
	<div class="includeLoader includeText">Processando, favor aguardar finalização da execução.</div>

	<div class="row">
		<div class="col-md-12">
		    <div id="custom-toolbar">
				<button type="button" class="btn btn-success btn-md" onclick="doSave()">
					<span class="glyphicon glyphicon-ok"></span> Salvar
				</button>

				<div class="btn-group" role="group" aria-label="...">
					<div class="btn-group" role="group">
						<button type="button" id="filter-departamento" class="btn btn-info btn-md btn-block dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
							<span class="glyphicon glyphicon-filter"></span> Selecione um departamento...
						</button>
						<ul class="dropdown-menu list-group"  style="width: 100%;">
							$> for (a = 1; a <= $c{departamento:count}; a++) {
								<li class="list-group-item" onclick="filterDepartamento(~~~)"><h4>~~~</h4></li> -> $c{iddepartamento[a]}; $c{departamento[a]};
							$> }
						</ul>
				    </div>
				    
			        <button type="button" class="btn btn-primary btn-md" onclick="doExport()">
					    <span class="glyphicon glyphicon-cloud-download"></span> Exportar
					</button>
				</div>
				
				<span type="button" class="title lead"></span>

				<div class="btn-group" role="group" aria-label="...">
					<button type="button" class="btn btn-danger btn-md" onclick="history.go(0);">
					    <span class="glyphicon glyphicon-arrow-left"></span> Voltar
					</button>
			        <button type="button" class="btn btn-primary btn-md" onclick="location.href=\'odwctrl?action=menu\'">
					    <span class="glyphicon glyphicon-tasks"></span> Menu
					</button>
				</div>

				<div class="btn-group" role="group">
					<button type="button" class="btn btn-success btn-md" onclick="openAddProdutoModal()">
						<span class="glyphicon glyphicon-plus"></span> Incluir
					</button>
				</div>

				<div style="margin:10px;">
					<div class="btn-group" role="group" aria-label="...">
						<div class="btn-group" role="group">
							<button type="button" id="apply-atividaderealizada" class="btn btn-info btn-md btn-block dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
								Selecione uma opção...
							</button>
							<ul class="dropdown-menu list-group"  style="width: 100%;">
							$> for (a = 1; a <= $c{idwfatividaderealizada:count}; a++) {
								<li class="list-group-item" onclick="setCurrAtvRealizada(~~~)"><h4>~~~</h4></li> -> $c{idwfatividaderealizada[a]}; $c{atividaderealizada[a]};
							$> }
							</ul>
						</div>
				        <button type="button" class="btn btn-primary btn-md" onclick="applyAtvRealizada()">
						    Aplicar nos selecionados
						</button>
					</div>
				</div>

				<div name="alert_primary" style="position: absolute;top: 0;z-index: 10;width:25vw;"></div>
		    </div>
			<table id="data-table"></table>
		</div>
	</div>

	<div id="modal" class="modal fade">
	  <div class="modal-dialog">
	    <div class="modal-content">
	      <div class="modal-header">
	        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
	        <h1 class="modal-title"></h1>
	      </div>
	      <div class="modal-body">
	      </div>
	    </div><!-- /.modal-content -->
