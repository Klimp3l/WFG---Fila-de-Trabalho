</body>

	<script src="js/jquery-2.1.0.min.js" type="text/javascript" language="javascript"></script>

	<script src="js/bootstrap-3.2.0/js/bootstrap.min.js" type="text/javascript" language="javascript"></script>

    <script src="js/bootstrap-table-1.8.1/bootstrap-table.min.js"></script>
	<script src="js/bootstrap-table-1.8.1/locale/bootstrap-table-pt-BR.min.js" charset="UTF-8"></script>

	<script src="https://code.jquery.com/ui/1.11.0/jquery-ui.js"></script>

<script_content name="funcs">

		bootstrap_alert = function() {}
		bootstrap_alert.warning = function (message) {
        	$('[name=alert_placeholder]').append('<div class="alert alert-danger"><a class="close" data-dismiss="alert">×</a><span>'+message+'</span></div>')
        }
		bootstrap_alert.success = function (message) {
        	$('[name=alert_primary]').append('<div class="alert alert-success"><span><span class="glyphicon glyphicon-ok" aria-hidden="true"></span>'+message+'</span></div>')

        	setTimeout(function () {
        		$('[name=alert_primary]').html('');
        	}, 3000);
        }
	function getFormData($form) {
		var unindexed_array = $form.serializeArray();
		var indexed_array = {};
		
		$.map(unindexed_array, function(n, i){
		    indexed_array[n['name']] = n['value'];
		});
		
		return indexed_array;
	}

	function doSaveNewProduct() {
		let data = getFormData($("form"));
		data.idempresa = idempresa;
		data.datavencimento = maskDateValue(data.datavencimento || '');
		$("#datavencimento").val(data.datavencimento);
		var dateValidation = validateDateByBusinessRule(data.datavencimento);
		$('[name=alert_placeholder]').html('');
		if (!(data.codigobarras || data.idproduto)) {
			bootstrap_alert.warning('Por favor, informe o código interno ou de barras.');
		}
		if (!data.qtdvencer) {
			bootstrap_alert.warning('Por favor, informe a quantidade.');
		}
		if (!data.datavencimento) {
			bootstrap_alert.warning('Por favor, informe a data de vencimento.');
		} else if (data.datavencimento.length !== 10 || !isValidDate(data.datavencimento)) {
			bootstrap_alert.warning('Por favor, informe uma data de vencimento válida no formato dd/mm/aaaa.');
		} else if (!dateValidation.isValid) {
			bootstrap_alert.warning(dateValidation.message);
		}
		
		if ((data.codigobarras || data.idproduto) && data.qtdvencer && data.datavencimento && data.datavencimento.length === 10 && isValidDate(data.datavencimento) && dateValidation.isValid) {
			$('[name=alert_placeholder]').html('');
			$('.includeLoader').show();
		    $.ajax({
		        type: "POST",
		        dataType: "json",
		        url: "odwctrl?action=execTarefa&ajax=true&scriptFunction=addNewProduto&idTarefa=" + idTarefa,
		        data: data,
		        contentType: "application/x-www-form-urlencoded; charset=ISO-8859-1",
		        success: function (response) {
		        	$('.includeLoader').hide();
		        	if (response.error === '') {
						$("#add-modal").modal('hide');
		        		bootstrap_alert.success(response.msg);
		        	} else {
		        		$('.includeLoader').hide();
		        		bootstrap_alert.warning(response.error);
		        	}
		        },
		        fail: function () {
		        	$('.includeLoader').hide();
		        	bootstrap_alert.warning("Erro ao conectar no servidor. Contate o suporte ajuda@iandev.com.br");
		        },
		        error: function () {
		        	$('.includeLoader').hide();
		        	bootstrap_alert.warning("Erro ao conectar no servidor. Contate o suporte ajuda@iandev.com.br");
		        }
		    });
		}
	}
	function openAddProdutoModal() {
		$("#add-modal").modal('show');
	}

	function syncData() {
		return new Promise(resolve => {
			let tempData = localStorage.getItem(key);
			if (tempData) {
				tempData = JSON.parse(tempData);
				let data = $table.bootstrapTable('getData');
				for (var i = 0; i < data.length; i++) {
					var row = tempData.filter(index => (index.idwffilatrabalho === data[i].idwffilatrabalho))[0];
					if (row) {
						data[i] = row;
						$table.bootstrapTable('updateRow', {index: i, row: data[i]});
						//return dropDownRender(data[i].idwfatividaderealizada, data[i], i, "idwfatividaderealizada");
					}
				}
			}
			resolve(true);
		});
	}

	function doSaveTemp() {
		let data = $.grep($table.bootstrapTable("getData"), function(r) { return r.idwfatividaderealizada });
		localStorage.setItem(key, JSON.stringify(data));
	}

	function doSave() {
		$("#sync-modal").modal('hide');
		var records = $.grep($table.bootstrapTable("getData"), function(r) { return r.idwfatividaderealizada });
		var invalidDateMessage = validateRecordsDateRange(records);
		if (invalidDateMessage) {
			showPrimaryWarning(invalidDateMessage);
			return;
		}
		$('.includeLoader').show();
	    $.ajax({
	        type: "POST",
	        dataType: "json",
	        url: "odwctrl?action=execTarefa&ajax=true&scriptFunction=update&idTarefa=" + idTarefa,
	        data: { wffilatrabalho: JSON.stringify(records) }, 
	        contentType: "application/x-www-form-urlencoded; charset=ISO-8859-1",
	        success: function(response) {
	        	$('.includeLoader').hide();
				if(showResponse(response)) {
					localStorage.removeItem(key);
					hideRows(getRecids(records).split(","));			
				}
	        }
	    });
	}

	function getRecids(records) {
		var recids = "0";
		for(var r in records) {
			recids += "," + records[r].recid;
		}
		return recids;
	}

	function doExport() {
	    $.ajax({
	        type: "POST",
	        dataType: "text",
	        url: "odwctrl?action=execTarefa&ajax=true&scriptFunction=export&idTarefa=" + idTarefa,
	        data: { wffilatrabalho: JSON.stringify($table.bootstrapTable("getData")) }, 
	        contentType: "application/x-www-form-urlencoded; charset=ISO-8859-1",
	        success: function(response) {
	            $("<iframe>", { src: $(response).filter("a").attr("href") })
	            	.hide()
	            	.appendTo($("body"));
	        }
	    });
	}

	function showResponse(response) {
		var error = response.error.length > 0;
		$(".modal-title").html((error ? "<span class=\'glyphicon glyphicon-remove-circle\'></span>" : "<span class=\'glyphicon glyphicon-ok-circle\'></span> ") + response.msg);
		$(".modal-body").html(error ? "<div class=\'alert alert-danger\' role=\'alert\'> " + response.error + "</div>" : "");
		$("#modal").modal("show");
		return !error;
	}

	function hideRows(recids) {
		$table.bootstrapTable("remove", { field: "recid", values: recids });
	}

    function setDropDown(rowIndex, fieldName, fieldValue) {
		$table.bootstrapTable("updateCell", { rowIndex: rowIndex, fieldName: fieldName, fieldValue: fieldValue });
    }

    function filterDepartamento(iddepartamento) {
		var par = { iddepartamento: iddepartamento };
		$("#filter-departamento").html(getText(par, "iddepartamento", labels.iddepartamento));
		$table.bootstrapTable("filterBy", par);
    }

    function setCurrAtvRealizada(idwfatividaderealizada) {
    	_idwfatividaderealizada = idwfatividaderealizada;
		var par = { idwfatividaderealizada: idwfatividaderealizada };
		$("#apply-atividaderealizada").html(getText(par, "idwfatividaderealizada", labels.idwfatividaderealizada));
    }

	function applyAtvRealizada() {
		let allTableData = $table.bootstrapTable("getData");
		let data = $table.bootstrapTable('getSelections');
		console.log(data);
		for (var i = 0; i < data.length; i++) {
			for (var j = 0; j < allTableData.length; j++) {
				if (data[i].recid === allTableData[j].recid) {
					$table.bootstrapTable('updateRow', {
						index: j,
						row: {
							idwfatividaderealizada: _idwfatividaderealizada,
						}
					});
				}
			}
		}
		//$table.bootstrapTable('refresh');
	}

    function textRender(value, row, index, fieldName){
		if (row.idwfatividade === 30010 && fieldName !== 'observacao') {
    		return value;
    	}  else if (!value) {
			value = '';
		}
    	return [
			\'<div class="input-group">\',
				\'<input class="render" type="text" class="form-control"\'
				+ \' onload="new NumberLoad(this, \' + index + \', \\\'\' + fieldName + \'\\\')"\'
				+ \' value="\' + value + \'"\'
				+ \' name="\' + fieldName + \'"\'
				+ \'/>\',
			\'</div>\'
    	].join("");
    }

    function numberRender(value, row, index, fieldName){
			if (row.idwfatividade === 30010) {
    		return value;
    	}
    	return [
			\'<div class="input-group">\',
				\'<input class="render" type="number" class="form-control"\'
				+ \' onload="new NumberLoad(this, \' + index + \', \\\'\' + fieldName + \'\\\')"\'
				+ \' value="\' + value + \'"\'
				+ \' name="\' + fieldName + \'"\'
				+ \'/>\',
			\'</div>\'
    	].join("");
    }

	function NumberLoad(el, rowIndex, fieldName) {
		$(el).change(function () {
			$table.bootstrapTable("updateCell", { rowIndex: rowIndex, fieldName: fieldName, fieldValue: this.value });
		});
	}

	function calendarRender(value, row, index, fieldName){
		if (row.idwfatividade === 30010) {
    		return value;
    	} else if (value == null) {
			value = '';
    	}
    	return [
			\'<div class="input-group">\',
				\'<input class="render" type="text" class="form-control"\'
				+ \' onload="new DatePicker(this, \' + index + \', \\\'\' + fieldName + \'\\\')"\'
				+ \' value="\' + value + \'"\'
				+ \' maxlength="10"\'
				+ \' placeholder="dd/mm/aaaa"\'
				+ \' inputmode="numeric"\'
				+ \' name="\' + fieldName + \'"\'
				+ \'/>\',
			\'</div>\'
    	].join("");
    }

	function DatePicker(el, rowIndex, fieldName) {
		console.log(el);
		var $el = $(el);
		bindDateMask($el);
		$el.datepicker({
			dateFormat: "dd/mm/yy"
		}).change(function () {
			this.value = maskDateValue(this.value);
			if (!isValidDate(this.value)) {
				this.value = '';
			} else {
				var dateValidation = validateDateByBusinessRule(this.value);
				if (!dateValidation.isValid) {
					this.value = '';
					showPrimaryWarning(dateValidation.message);
				}
			}
			$table.bootstrapTable("updateCell", { rowIndex: rowIndex, fieldName: fieldName, fieldValue: this.value });
		});
	}

	function showPrimaryWarning(message) {
		$('[name=alert_primary]').append('<div class="alert alert-danger"><span><span class="glyphicon glyphicon-warning-sign" aria-hidden="true"></span> '+message+'</span></div>');
		setTimeout(function () {
			$('[name=alert_primary]').html('');
		}, 4000);
	}

	function maskDateValue(value) {
		var digits = (value || '').replace(/\\D/g, '').substring(0, 8);
		var day = digits.substring(0, 2);
		var month = digits.substring(2, 4);
		var year = digits.substring(4, 8);
		var formatted = day;
		if (month.length) {
			formatted += '/' + month;
		}
		if (year.length) {
			formatted += '/' + year;
		}
		return formatted;
	}

	function bindDateMask($input) {
		$input.on('input', function() {
			var maskedValue = maskDateValue(this.value);
			if (this.value !== maskedValue) {
				this.value = maskedValue;
			}
		}).on('blur', function() {
			if (this.value && (this.value.length !== 10 || !isValidDate(this.value) || !validateDateByBusinessRule(this.value).isValid)) {
				this.value = '';
			}
		});
	}

	function parseBrDate(dateString) {
		var parts = dateString.split("/");
		return new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
	}

	function formatBrDate(dateObj) {
		var day = ('0' + dateObj.getDate()).slice(-2);
		var month = ('0' + (dateObj.getMonth() + 1)).slice(-2);
		return day + '/' + month + '/' + dateObj.getFullYear();
	}

	function validateDateByBusinessRule(dateString) {
		if (!dateString || !isValidDate(dateString)) {
			return { isValid: false, message: 'Por favor, informe uma data válida no formato dd/mm/aaaa.' };
		}

		var dateToValidate = parseBrDate(dateString);
		var today = new Date();
		today.setHours(0, 0, 0, 0);

		var minAllowedDate = new Date(today.getTime());
		minAllowedDate.setMonth(minAllowedDate.getMonth() - DATE_BUSINESS_RULES.minMonthsBeforeToday);

		var maxAllowedDate = new Date(today.getTime());
		maxAllowedDate.setFullYear(maxAllowedDate.getFullYear() + DATE_BUSINESS_RULES.maxYearsFromToday);

		if (dateToValidate < minAllowedDate) {
			return { isValid: false, message: 'Data inválida. O vencimento deve ser a partir de ' + formatBrDate(minAllowedDate) + '.' };
		}

		if (dateToValidate > maxAllowedDate) {
			return { isValid: false, message: 'Data inválida. O vencimento deve ser até ' + formatBrDate(maxAllowedDate) + '.' };
		}

		return { isValid: true, message: '' };
	}

	function validateRecordsDateRange(records) {
		for (var i = 0; i < records.length; i++) {
			var reviewedDate = maskDateValue(records[i].datavencimentorevisada || '');
			if (!reviewedDate) {
				continue;
			}
			var dateValidation = validateDateByBusinessRule(reviewedDate);
			if (!dateValidation.isValid) {
				return 'Produto ' + (records[i].codigobarras || records[i].idproduto || '') + ': ' + dateValidation.message;
			}
		}
		return '';
	}

		// Validates that the input string is a valid date formatted as "mm/dd/yyyy"
	function isValidDate(dateString)
	{
	
	    // Parse the date parts to integers
	    var parts = dateString.split("/");
	    var day = parseInt(parts[0], 10);
	    var month = parseInt(parts[1], 10);
	    var year = parseInt(parts[2], 10);
	
	    // Check the ranges of month and year
	    if(year < 1000 || year > 3000 || month == 0 || month > 12)
	        return false;
	
	    var monthLength = [ 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 ];
	
	    // Adjust for leap years
	    if(year % 400 == 0 || (year % 100 != 0 && year % 4 == 0))
	        monthLength[1] = 29;
	
	    // Check the range of the day
	    return day > 0 && day <= monthLength[month - 1];
	};

    function dropDownRender(value, row, index, fieldName) {
		return [
		    \'<div class="dropdown">\',
		      \'<button type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" class="btn btn-\' + (value ? \'success\' : \'info\') +  \' btn-lg btn-block dropdown-toggle">\',
				value ? getText(row, fieldName, labels[fieldName]) : "Selecione uma opção...",
			\'</button>\',
			\'<ul class="dropdown-menu list-group"  style="width: 100%;"><li>\',
				getDropDownList(index, fieldName, labels[fieldName]),
			\'</li></ul>\',
		    \'</div>\'
		].join("");
    }

    function decimalRender(value, row, index, fieldName, dc) {
		return value === null ? "-" : Number(value).format(dc);
	};

	function integerRender(value, row, index, fieldName) {
		return value === null ? "-" : Number(value).format(0);
	};

	function getText(record, col, lab) {
		for (var i in lab) {
			if (lab[i].id == record[col]) {
				return lab[i].text;
			}
		}
		return "";
	}

    function getDropDownList(index, fieldName, list) {
		var html = "";
		for(var i in list) {
			html += "<li class=\\"list-group-item\\" onclick=\\"setDropDown(" + [ index, "\'" + fieldName + "\'",  list[i].id].join() + ")\\\"><h4>" + list[i].text + "</h4></li>";
		}
		return html;
    }

	Number.prototype.format = function(c, d, t) {
		var n = this, 
		    c = isNaN(c = Math.abs(c)) ? 2 : c, 
		    d = d == undefined ? "," : d, 
		    t = t == undefined ? "." : t, 
		    s = n < 0 ? "-" : "", 
		    i = String(parseInt(n = Math.abs(Number(n) || 0).toFixed(c))), 
		    j = (j = i.length) > 3 ? j % 3 : 0;
		   return s + (j ? i.substr(0, j) + t : "") + i.substr(j).replace(/(\\d{3})(?=\\d)/g, "$1" + t) + (c ? d + Math.abs(n - i).toFixed(c).slice(2) : "");
	};
